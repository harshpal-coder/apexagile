# Platform Port
PORT=5000

# MongoDB Online Connection String (Atlas URI)
# Paste your connection string here. Make sure to replace <db_password> and your database name.
MONGODB_URI=mongodb+srv://<username>:<db_password>@cluster0.xxxxxx.mongodb.net/apexagile?retryWrites=true&w=majority

# JWT Security Key
JWT_SECRET=agile_jira_secret_key_2026

# Google OAuth2 Client ID
GOOGLE_CLIENT_ID=your-google-oauth2-client-id-here.apps.googleusercontent.com

# Allowed CORS Origins for separate frontend deployment
# Comma-separated list (e.g., https://apexagile.vercel.app,http://localhost:5173)
# Leave unset to dynamically copy request origins (easy development/testing)
CORS_ORIGIN=https://your-frontend.vercel.app
