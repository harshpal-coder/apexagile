# ApexAgile Frontend Environment Variables

# The absolute URL pointing to your deployed backend's /api route.
# For example, if your backend is deployed at https://apexagile-api.onrender.com
# then set this value to: https://apexagile-api.onrender.com/api
# Leave empty for local development (defaults to http://localhost:5000/api when running on localhost)
VITE_API_URL=
