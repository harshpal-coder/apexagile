{
  "name": "apexagile-mern-platform",
  "version": "1.0.0",
  "description": "Unified root orchestrator for deploying ApexAgile full-stack MERN platform",
  "main": "server/server.js",
  "scripts": {
    "install-server": "cd server && npm install",
    "install-client": "cd client && npm install --legacy-peer-deps",
    "build-client": "cd client && npm run build",
    "build": "npm run install-server && npm run install-client && npm run build-client",
    "start": "cross-env NODE_ENV=production node server/server.js",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\""
  },
  "dependencies": {
    "cross-env": "^7.0.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
